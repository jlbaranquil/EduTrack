<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="EduTrack.Mobile.StudentDetailsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="{DynamicResource CardBackgroundColor}"
    NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto, *">

        <!-- 1. TOP MODAL HEADER BAR -->
        <Grid
            Grid.Row="0"
            BackgroundColor="{StaticResource HeaderNavyColor}"
            Padding="16,12"
            ColumnDefinitions="*, Auto">

            <Label
                Grid.Column="0"
                x:Name="lblPageHeaderTitle"
                Text="📋 ADD NEW STUDENT"
                TextColor="White"
                FontFamily="Poppins"
                FontSize="16"
                FontAttributes="Bold"
                VerticalOptions="Center" />

            <!-- Close [✕] Button -->
            <Button
                Grid.Column="1"
                x:Name="btnClose"
                Text="✕"
                BackgroundColor="{StaticResource HeaderBadgeBgColor}"
                TextColor="White"
                FontSize="16"
                FontAttributes="Bold"
                CornerRadius="8"
                WidthRequest="38"
                HeightRequest="38"
                Padding="0"
                VerticalOptions="Center"
                Clicked="btnClose_Clicked" />
        </Grid>

        <!-- 2. SCROLLABLE FORM BODY -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="18,18,18,24" Spacing="0">

                <!-- Profile Picture Display -->
                <Border
                    x:Name="bdrProfilePicture"
                    IsVisible="False"
                    WidthRequest="120"
                    HeightRequest="120"
                    HorizontalOptions="Center"
                    BackgroundColor="{DynamicResource AvatarBackgroundColor}"
                    Stroke="{DynamicResource AvatarBorderColor}"
                    StrokeThickness="2"
                    StrokeShape="RoundRectangle 24"
                    Margin="0,0,0,18">
                    <Grid>
                        <Label
                            x:Name="lblPhotoInitials"
                            Text="👤"
                            TextColor="{DynamicResource AvatarTextColor}"
                            FontFamily="Poppins"
                            FontSize="38"
                            FontAttributes="Bold"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                        <Image
                            x:Name="imgStudentPhoto"
                            Aspect="AspectFill"
                            WidthRequest="120"
                            HeightRequest="120"
                            IsVisible="False" />
                    </Grid>
                </Border>

                <!-- Student ID -->
                <Label
                    Text="Student ID:"
                    TextColor="{DynamicResource SecondaryTextColor}"
                    FontFamily="Inter"
                    FontSize="14"
                    FontAttributes="Bold"
                    Margin="0,0,0,6" />
                <Border
                    BackgroundColor="{DynamicResource InputBackgroundColor}"
                    Stroke="{DynamicResource InputBorderColor}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 10"
                    Padding="12,3"
                    Margin="0,0,0,16">
                    <Entry
                        x:Name="txtStudentID"
                        Placeholder="e.g. 2026-0013"
                        PlaceholderColor="{DynamicResource MutedTextColor}"
                        TextColor="{DynamicResource PrimaryTextColor}"
                        FontFamily="Inter"
                        FontSize="15.5"
                        BackgroundColor="Transparent" />
                </Border>

                <!-- Full Name -->
                <Label
                    Text="Full Name:"
                    TextColor="{DynamicResource SecondaryTextColor}"
                    FontFamily="Inter"
                    FontSize="14"
                    FontAttributes="Bold"
                    Margin="0,0,0,6" />
                <Border
                    BackgroundColor="{DynamicResource InputBackgroundColor}"
                    Stroke="{DynamicResource InputBorderColor}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 10"
                    Padding="12,3"
                    Margin="0,0,0,16">
                    <Entry
                        x:Name="txtFullName"
                        Placeholder="First &amp; Last Name"
                        PlaceholderColor="{DynamicResource MutedTextColor}"
                        TextColor="{DynamicResource PrimaryTextColor}"
                        FontFamily="Inter"
                        FontSize="15.5"
                        BackgroundColor="Transparent" />
                </Border>

                <!-- Gender RadioButtons -->
                <Label
                    Text="Gender:"
                    TextColor="{DynamicResource SecondaryTextColor}"
                    FontFamily="Inter"
                    FontSize="14"
                    FontAttributes="Bold"
                    Margin="0,0,0,6" />
                <HorizontalStackLayout
                    Spacing="22"
                    Margin="0,0,0,16"
                    BackgroundColor="Transparent"
                    RadioButtonGroup.GroupName="StudentGenderGroup">
                    <RadioButton
                        x:Name="rbMale"
                        Content="Male"
                        Value="Male"
                        IsChecked="True"
                        BackgroundColor="Transparent"
                        TextColor="{DynamicResource PrimaryTextColor}"
                        FontFamily="Inter"
                        FontSize="15" />
                    <RadioButton
                        x:Name="rbFemale"
                        Content="Female"
                        Value="Female"
                        BackgroundColor="Transparent"
                        TextColor="{DynamicResource PrimaryTextColor}"
                        FontFamily="Inter"
                        FontSize="15" />
                    <RadioButton
                        x:Name="rbOther"
                        Content="Other"
                        Value="Other"
                        BackgroundColor="Transparent"
                        TextColor="{DynamicResource PrimaryTextColor}"
                        FontFamily="Inter"
                        FontSize="15" />
                </HorizontalStackLayout>

                <!-- Year Level Picker -->
                <Label
                    Text="Year Level:"
                    TextColor="{DynamicResource SecondaryTextColor}"
                    FontFamily="Inter"
                    FontSize="14"
                    FontAttributes="Bold"
                    Margin="0,0,0,6" />
                <Border
                    BackgroundColor="{DynamicResource InputBackgroundColor}"
                    Stroke="{DynamicResource InputBorderColor}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 10"
                    Padding="12,3"
                    Margin="0,0,0,16">
                    <Grid ColumnDefinitions="*, Auto">
                        <Picker
                            Grid.Column="0"
                            x:Name="pkrYearLevel"
                            TextColor="{DynamicResource PrimaryTextColor}"
                            FontFamily="Inter"
                            FontSize="15.5" />
                        <Label
                            Grid.Column="1"
                            Text="▾"
                            TextColor="{DynamicResource MutedTextColor}"
                            FontSize="14"
                            VerticalOptions="Center"
                            Margin="0,0,4,0" />
                    </Grid>
                </Border>

                <!-- Program Picker -->
                <Label
                    Text="Program:"
                    TextColor="{DynamicResource SecondaryTextColor}"
                    FontFamily="Inter"
                    FontSize="14"
                    FontAttributes="Bold"
                    Margin="0,0,0,6" />
                <Border
                    BackgroundColor="{DynamicResource InputBackgroundColor}"
                    Stroke="{DynamicResource InputBorderColor}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 10"
                    Padding="12,3"
                    Margin="0,0,0,16">
                    <Grid ColumnDefinitions="*, Auto">
                        <Picker
                            Grid.Column="0"
                            x:Name="pkrProgram"
                            TextColor="{DynamicResource PrimaryTextColor}"
                            FontFamily="Inter"
                            FontSize="15.5" />
                        <Label
                            Grid.Column="1"
                            Text="▾"
                            TextColor="{DynamicResource MutedTextColor}"
                            FontSize="14"
                            VerticalOptions="Center"
                            Margin="0,0,4,0" />
                    </Grid>
                </Border>

                <!-- Contact No. (11 Digits) -->
                <Label
                    Text="Contact No. (11 Digits):"
                    TextColor="{DynamicResource SecondaryTextColor}"
                    FontFamily="Inter"
                    FontSize="14"
                    FontAttributes="Bold"
                    Margin="0,0,0,6" />
                <Border
                    BackgroundColor="{DynamicResource InputBackgroundColor}"
                    Stroke="{DynamicResource InputBorderColor}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 10"
                    Padding="12,3"
                    Margin="0,0,0,24">
                    <Entry
                        x:Name="txtContact"
                        Placeholder="09XXXXXXXXX"
                        PlaceholderColor="{DynamicResource MutedTextColor}"
                        TextColor="{DynamicResource PrimaryTextColor}"
                        FontFamily="Inter"
                        FontSize="15.5"
                        Keyboard="Numeric"
                        MaxLength="11"
                        BackgroundColor="Transparent" />
                </Border>

                <Grid
                    RowDefinitions="50"
                    ColumnDefinitions="*, *"
                    ColumnSpacing="12">

                    <!-- ADD NEW STUDENT MODE BUTTONS -->
                    <Button
                        Grid.Row="0"
                        Grid.Column="0"
                        x:Name="btnAdd"
                        Text="+ Add"
                        BackgroundColor="{StaticResource PrimaryIndigoColor}"
                        TextColor="White"
                        FontFamily="Inter"
                        FontSize="15"
                        FontAttributes="Bold"
                        CornerRadius="10"
                        Clicked="btnAdd_Clicked" />

                    <Button
                        Grid.Row="0"
                        Grid.Column="1"
                        x:Name="btnClear"
                        Text="🔄 Clear"
                        BackgroundColor="#E2E8F0"
                        TextColor="#0F172A"
                        FontFamily="Inter"
                        FontSize="15"
                        FontAttributes="Bold"
                        CornerRadius="10"
                        Clicked="btnClear_Clicked" />

                    <!-- STUDENT DETAILS MODE BUTTONS -->
                    <Button
                        Grid.Row="0"
                        Grid.Column="0"
                        x:Name="btnUpdate"
                        IsVisible="False"
                        Text="✏️ Update"
                        BackgroundColor="{StaticResource SuccessEmeraldColor}"
                        TextColor="White"
                        FontFamily="Inter"
                        FontSize="15"
                        FontAttributes="Bold"
                        CornerRadius="10"
                        Clicked="btnUpdate_Clicked" />

                    <Button
                        Grid.Row="0"
                        Grid.Column="1"
                        x:Name="btnDelete"
                        IsVisible="False"
                        Text="🗑️ Delete"
                        BackgroundColor="{StaticResource DangerRoseColor}"
                        TextColor="White"
                        FontFamily="Inter"
                        FontSize="15"
                        FontAttributes="Bold"
                        CornerRadius="10"
                        Clicked="btnDelete_Clicked" />
                </Grid>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
