<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EduTrack.Mobile.MainPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{DynamicResource PageBackgroundColor}">

    <Grid RowDefinitions="Auto, Auto, *">

        <!-- ==================== ROW 0: CENTERED TWO-ROW TOP NAVIGATION BAR ==================== -->
        <VerticalStackLayout Grid.Row="0"
                             BackgroundColor="#0F172A"
                             Padding="14,10,14,10"
                             Spacing="8">

            <!-- TOP SUB-ROW: Centered App Logo + App Title -->
            <HorizontalStackLayout HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   Spacing="8">
				<Image x:Name="imgHeaderLogo"
					   Source="edutrack_logo.png"
					   WidthRequest="36"
					   HeightRequest="36"
					   Aspect="AspectFit"
					   VerticalOptions="Center" />
                <Label x:Name="lblAppTitle"
                       Text="EDUTRACK"
                       TextColor="#FFFFFF"
                       FontSize="18"
                       FontAttributes="Bold"
                       CharacterSpacing="1.2"
                       LineBreakMode="NoWrap"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>

            <!-- BOTTOM SUB-ROW: Centered Narrow Action Bar (Host Status Badge, Theme Toggle, Sign Out) -->
            <HorizontalStackLayout HeightRequest="30"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   Spacing="8">

                <!-- Read-Only MySQL Server Host Indicator Pill -->
                <Border x:Name="pnlHostBadge"
                        BackgroundColor="#1E293B"
                        Stroke="#334155"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 8"
                        HeightRequest="30"
                        Padding="10,0"
                        VerticalOptions="Center">
                    <HorizontalStackLayout Spacing="5"
                                           VerticalOptions="Center">
                        <Label x:Name="lblHostDot"
                               Text="●"
                               TextColor="#10B981"
                               FontSize="10"
                               VerticalOptions="Center" />
                        <Label x:Name="lblHostAddress"
                               Text="10.0.2.2"
                               TextColor="#10B981"
                               FontSize="11"
                               FontAttributes="Bold"
                               LineBreakMode="NoWrap"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>

                <!-- Theme Toggle Button (Light / Dark Mode) -->
                <Button x:Name="btnThemeToggle"
                        Text="🌙"
                        BackgroundColor="#1E293B"
                        TextColor="#F8FAFC"
                        BorderColor="#334155"
                        BorderWidth="1"
                        CornerRadius="8"
                        FontSize="13"
                        Padding="0"
                        WidthRequest="36"
                        HeightRequest="30"
                        VerticalOptions="Center"
                        Clicked="btnThemeToggle_Clicked" />

                <!-- Sign Out Button -->
                <Button x:Name="btnSignOut"
                        Text="➔ Sign Out"
                        BackgroundColor="#E11D48"
                        TextColor="#FFFFFF"
                        FontAttributes="Bold"
                        FontSize="12"
                        CornerRadius="8"
                        Padding="12,0"
                        HeightRequest="30"
                        VerticalOptions="Center"
                        Clicked="btnSignOut_Clicked" />
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <!-- ==================== ROW 1: SEARCH & FILTER CARD + RECORD COUNT ==================== -->
        <VerticalStackLayout Grid.Row="1"
                             Padding="14,12,14,4"
                             Spacing="10">

            <Border BackgroundColor="{DynamicResource CardBackgroundColor}"
                    Stroke="{DynamicResource CardBorderColor}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    Padding="12">

                <VerticalStackLayout Spacing="10">

                    <!-- Search Bar -->
                    <Border BackgroundColor="{DynamicResource InputBackgroundColor}"
                            Stroke="{DynamicResource InputBorderColor}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            Padding="10,2"
                            HeightRequest="44">
                        <Grid ColumnDefinitions="Auto, *"
                              ColumnSpacing="8">
                            <Label Grid.Column="0"
                                   Text="🔍"
                                   FontSize="15"
                                   VerticalOptions="Center" />
                            <Entry x:Name="txtSearch"
                                   Grid.Column="1"
                                   Placeholder="Search by Student ID or Full Name..."
                                   PlaceholderColor="{DynamicResource MutedTextColor}"
                                   TextColor="{DynamicResource PrimaryTextColor}"
                                   FontSize="13.5"
                                   ClearButtonVisibility="WhileEditing"
                                   VerticalOptions="Center"
                                   TextChanged="txtSearch_TextChanged" />
                        </Grid>
                    </Border>

                    <!-- Filter Pickers + Add Button Row -->
                    <Grid ColumnDefinitions="*, *, Auto"
                          ColumnSpacing="8">

                        <!-- Year Level Filter -->
                        <Border Grid.Column="0"
                                BackgroundColor="{DynamicResource InputBackgroundColor}"
                                Stroke="{DynamicResource InputBorderColor}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10"
                                Padding="8,0"
                                HeightRequest="42">
                            <Grid ColumnDefinitions="*, Auto">
                                <Picker x:Name="cmbFilterYear"
                                        Grid.Column="0"
                                        Title="All Years"
                                        TextColor="{DynamicResource PrimaryTextColor}"
                                        TitleColor="{DynamicResource SecondaryTextColor}"
                                        FontSize="12.5"
                                        VerticalOptions="Center"
                                        SelectedIndexChanged="FilterPicker_SelectedIndexChanged" />
                                <Label Grid.Column="1"
                                       Text="▾"
                                       TextColor="{DynamicResource SecondaryTextColor}"
                                       FontSize="12"
                                       VerticalOptions="Center"
                                       InputTransparent="True" />
                            </Grid>
                        </Border>

                        <!-- Program Filter -->
                        <Border Grid.Column="1"
                                BackgroundColor="{DynamicResource InputBackgroundColor}"
                                Stroke="{DynamicResource InputBorderColor}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10"
                                Padding="8,0"
                                HeightRequest="42">
                            <Grid ColumnDefinitions="*, Auto">
                                <Picker x:Name="cmbFilterProgram"
                                        Grid.Column="0"
                                        Title="All Programs"
                                        TextColor="{DynamicResource PrimaryTextColor}"
                                        TitleColor="{DynamicResource SecondaryTextColor}"
                                        FontSize="12.5"
                                        VerticalOptions="Center"
                                        SelectedIndexChanged="FilterPicker_SelectedIndexChanged" />
                                <Label Grid.Column="1"
                                       Text="▾"
                                       TextColor="{DynamicResource SecondaryTextColor}"
                                       FontSize="12"
                                       VerticalOptions="Center"
                                       InputTransparent="True" />
                            </Grid>
                        </Border>

                        <!-- + Add Student Button -->
                        <Button x:Name="btnAddStudent"
                                Grid.Column="2"
                                Text="+ Add Student"
                                BackgroundColor="#4F46E5"
                                TextColor="#FFFFFF"
                                FontAttributes="Bold"
                                FontSize="12.5"
                                CornerRadius="10"
                                Padding="14,0"
                                HeightRequest="42"
                                Clicked="btnAddStudent_Clicked" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Record Counter -->
            <Label x:Name="lblRecordCount"
                   Text="Showing 0 of 0 records"
                   TextColor="{DynamicResource SecondaryTextColor}"
                   FontSize="12.5"
                   Margin="4,0,0,2" />
        </VerticalStackLayout>

        <!-- ==================== ROW 2: STUDENT DIRECTORY LIST ==================== -->
        <RefreshView x:Name="refreshView"
                     Grid.Row="2"
                     RefreshColor="#4F46E5"
                     Refreshing="refreshView_Refreshing">

            <CollectionView x:Name="cvStudents"
                            Margin="14,0,14,14"
                            SelectionMode="None">

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical"
                                       ItemSpacing="10" />
                </CollectionView.ItemsLayout>

                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         Padding="30"
                                         Spacing="8">
                        <Label Text="📂"
                               FontSize="36"
                               HorizontalOptions="Center" />
                        <Label Text="No matching student records found."
                               TextColor="{DynamicResource SecondaryTextColor}"
                               FontSize="14"
                               FontAttributes="Bold"
                               HorizontalOptions="Center" />
                        <Label Text="Pull down to refresh or adjust your search filters."
                               TextColor="{DynamicResource MutedTextColor}"
                               FontSize="12"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="{DynamicResource CardBackgroundColor}"
                                Stroke="{DynamicResource CardBorderColor}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 14"
                                Padding="14,12">

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="StudentCard_Tapped"
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <Grid ColumnDefinitions="54, *, Auto"
                                  ColumnSpacing="12">

                                <!-- Avatar Box (Displays student photo downloaded from photo_path or 2-letter Initials) -->
                                <Border Grid.Column="0"
                                        WidthRequest="52"
                                        HeightRequest="52"
                                        BackgroundColor="{DynamicResource AvatarBackgroundColor}"
                                        Stroke="{DynamicResource AvatarBorderColor}"
                                        StrokeThickness="1.5"
                                        StrokeShape="RoundRectangle 12"
                                        VerticalOptions="Center">
                                    <Grid>
                                        <Label Text="{Binding Initials}"
                                               IsVisible="{Binding HasNoPhoto}"
                                               TextColor="{DynamicResource AvatarTextColor}"
                                               FontAttributes="Bold"
                                               FontSize="16"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                                        <Image Source="{Binding ResolvedPhotoPath}"
                                               IsVisible="{Binding HasPhoto}"
                                               Aspect="AspectFill"
                                               WidthRequest="52"
                                               HeightRequest="52" />
                                    </Grid>
                                </Border>

                                <!-- Student Info Column (Name, Student ID, and Year Level only) -->
                                <VerticalStackLayout Grid.Column="1"
                                                     Spacing="4"
                                                     VerticalOptions="Center">
                                    <Label Text="{Binding Name}"
                                           TextColor="{DynamicResource PrimaryTextColor}"
                                           FontSize="15.5"
                                           FontAttributes="Bold"
                                           LineBreakMode="TailTruncation" />

                                    <HorizontalStackLayout Spacing="6">
                                        <Label Text="{Binding StudentID}"
                                               TextColor="#4F46E5"
                                               FontSize="12.5"
                                               FontAttributes="Bold" />
                                        <Label Text="•"
                                               TextColor="{DynamicResource MutedTextColor}"
                                               FontSize="12.5" />
                                        <Label Text="{Binding YearLevel}"
                                               TextColor="{DynamicResource SecondaryTextColor}"
                                               FontSize="12.5" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>

                                <!-- Right Column: Program Pill Only -->
                                <Border Grid.Column="2"
                                        BackgroundColor="{Binding ProgramBadgeBackground}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 8"
                                        Padding="10,4"
                                        HorizontalOptions="End"
                                        VerticalOptions="Center">
                                    <Label Text="{Binding Program}"
                                           TextColor="{Binding ProgramBadgeTextColor}"
                                           FontSize="11"
                                           FontAttributes="Bold" />
                                </Border>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>
        </RefreshView>

    </Grid>
</ContentPage>
