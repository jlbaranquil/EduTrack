         connectionString="server=localhost;port=3306;database=edutrack_db;uid=YOUR_USERNAME;pwd=YOUR_PASSWORD;ConnectionTimeout=5;"
         providerName="MySql.Data.MySqlClient" />
  </connectionStrings>
</configuration>
